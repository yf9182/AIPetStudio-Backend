{
  "name": "ai-pet-studio-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:webhook && npm run test:pet-translator",
    "test:webhook": "node scripts/test-revenuecat-webhook.mjs",
    "test:pet-translator": "node scripts/test-pet-translator.mjs",
    "pet-sounds:validate": "node scripts/import-pet-sounds.mjs",
    "pet-sounds:sql": "node scripts/import-pet-sounds.mjs --sql-out /private/tmp/pet-translator-sounds.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.92.0"
  }
}
